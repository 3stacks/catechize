{
  "name": "hearers-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "description": "The iOS and Android app of Hearers, made with Expo (React Native).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "expo start",
